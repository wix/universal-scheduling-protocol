  "bq_answer_invalid": {
    "description": "Booking questions: create returns one recoverable message per failed question (exclusive 'None of the above' combined with another option, missing conditional follow-up); the hold is kept",
    "request": {
      "method": "POST",
      "path": "/bookings",
      "body": {
        "service_id": "svc_massage_001",
        "slot_id": "slot_mass_0315_0900",
        "hold_id": "hold_abc123def456",
        "buyer": {
          "first_name": "Jane",
          "last_name": "Doe",
          "email": "jane.doe@example.com",
          "phone_number": "+12125551234"
        },
        "booking_question_submissions": [
          {
            "set_id": "massage_intake",
            "revision": "r3",
            "answers": {
              "allergies": [
                "none",
                "other"
              ],
              "no_show_fee": true
            }
          }
        ]
      }
    },
    "response": {
      "status": 200,
      "body": {
        "usp": {
          "version": "2026-08-20",
          "capabilities": {
            "dev.usp-protocol.services.bookings": [
              {
                "version": "2026-08-20"
              }
            ],
            "dev.usp-protocol.services.booking_questions": [
              {
                "version": "2026-08-20"
              }
            ]
          }
        },
        "messages": [
          {
            "type": "error",
            "code": "booking_question_answer_invalid",
            "severity": "recoverable",
            "path": "$.booking_question_submissions[?@.set_id=='massage_intake'].answers['allergies']",
            "content": "'None of the above' cannot be combined with another option."
          },
          {
            "type": "error",
            "code": "booking_question_answer_missing",
            "severity": "recoverable",
            "path": "$.booking_question_submissions[?@.set_id=='massage_intake'].answers['allergies_other']",
            "content": "Please describe the other allergy."
          }
        ]
      }
    }
  },
